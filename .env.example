# ============================================
# 学霸星球 StudyPlanet 隐私配置模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，不会上传
#   cp .env.example .env
# ============================================

# ---- 数据库 ----
# 方式一：MySQL（推荐）
# DB_DRIVER=mysql
# DB_DSN=用户名:密码@tcp(主机:3306)/库名?charset=utf8mb4&parseTime=true&loc=Local
# 方式二：SQLite 文件（容器内路径，配合 compose 卷 db:/app/data）
DB_DRIVER=sqlite
DB_DSN=/app/data/studyplanet.db
SERVER_PORT=8080

# ---- 家长 PIN 登录（未配置 Casdoor 时启用）----
# 强烈建议改成你自己的 PIN 和长随机密钥
PARENT_PIN=1234
JWT_SECRET=请改成随机长字符串_至少32位

# ---- Casdoor SSO ----
# 注意：三项核心（ENDPOINT/CLIENT_ID/CLIENT_SECRET）全部填了真实值，
# 系统才会切换到 Casdoor 登录并关闭 PIN 登录
# 回调地址无需配置，自动按用户访问的地址实时生成（支持 X-Forwarded-* 反代头）
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG_NAME=built-in
CASDOOR_APP_NAME=studyplanet
